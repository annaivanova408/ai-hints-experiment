# PostgreSQL database stored in a persistent named volume.
POSTGRES_DB=ai_hints
POSTGRES_USER=ai_hints
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX

# Password used to sign in at /admin. Store it in a password manager.
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Generate with: openssl rand -hex 48
ADMIN_SECRET_KEY=CHANGE_ME_RANDOM_HEX

# Validate that all 32 bundled MP4 clips match data/stimuli.json at startup.
VALIDATE_MEDIA=true

# Existing HTTPS source used once to fill the persistent clips_data volume.
CLIPS_SOURCE_BASE_URL=https://edu1.datascope.online/clips

# Optional UDP destination for laboratory event markers. Leave blank/zero when unused.
MARKER_UDP_HOST=
MARKER_UDP_PORT=0
